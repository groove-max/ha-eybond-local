# EyeBond Local architecture graph
#
# Keep the graph focused on production code, executable architecture
# boundaries, real-HA lifecycles, tooling, and handwritten design docs.
# Graphify also respects .gitignore; these rules only narrow the corpus.

# Never ingest Graphify's own output or local/generated artifacts.
graphify-out/
.local/
field_dumps/
.codex/
AGENTS.md

# Repository automation and contribution forms describe the development
# process, not the integration's runtime architecture.  Keep them out of
# semantic extraction so their vocabulary cannot create inferred code links.
.github/workflows/
.github/ISSUE_TEMPLATE/
.github/PULL_REQUEST_TEMPLATE*

# Binary/UI assets and generated/reference-heavy documentation.
custom_components/eybond_local/brand/
docs/images/
docs/generated/
CHANGELOG.md
README.uk.md

# Localized copies and large data catalogs do not describe code authority.
custom_components/eybond_local/translations/
custom_components/eybond_local/flow_translations/
custom_components/eybond_local/strings.json
custom_components/eybond_local/protocol_catalogs/**/*.json
catalog/

# Replay/support fixtures are useful to tests, but add payload detail rather
# than architectural relationships to the first graph.
custom_components/eybond_local/fixtures/
tests/helpers/

# Start from selected executable invariants instead of all behavioral tests.
tests/*
!tests/test_*architecture.py
!tests/test_*guards.py
